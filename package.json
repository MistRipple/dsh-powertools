{
  "name": "dsh-powertools",
  "version": "0.2.0",
  "description": "DSH PowerTools for sessions, MCP, skills and prompt enhancement",
  "license": "MIT",
  "author": "MistRipple",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MistRipple/dsh-powertools.git"
  },
  "homepage": "https://github.com/MistRipple/dsh-powertools#readme",
  "bugs": {
    "url": "https://github.com/MistRipple/dsh-powertools/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "skills",
    "sessions",
    "prompt"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "lib",
    "icon.svg",
    "locale",
    "licenses"
  ],
  "engines": {
    "dsh": "0.2.3-alpha.2 || 0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "pack:plugin": "node scripts/pack.js",
    "smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "bundleDependencies": [
    "yaml"
  ],
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "semver": "^7.8.6"
  }
}
